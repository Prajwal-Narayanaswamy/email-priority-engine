docker/**/*.md
*.md
*.log
.env
.env*
.claude
.dvc
.dvcignore
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
coverage.xml
htmlcov
**/__pycache__
**/*.py[cod]
**/*.egg-info
diag_early_stopping.py
pyproject.toml
