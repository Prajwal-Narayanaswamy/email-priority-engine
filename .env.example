# Copy this to .env and fill in values. Never commit .env.

# MLflow — local tracking, SQLite backend (ADR-002).
# Read runs with:
#   mlflow ui --backend-store-uri sqlite:///mlruns/mlflow.db
# NOTE: nothing in src/ calls load_dotenv(), so these must be exported in the
# shell (e.g. `export MLFLOW_TRACKING_URI=...`) to take effect. This file is
# documentation, not runtime config.
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_EXPERIMENT_NAME=email-priority-classifier
# MLflow 3.x marks the filesystem store as maintenance-mode and raises on any
# read or write unless MLFLOW_ALLOW_FILE_STORE=true is exported. It is NOT needed
# for the SQLite backend above. Only set it if MLFLOW_TRACKING_URI is ever
# pointed back at a file store, e.g. file:///abs/path/mlruns.
# MLFLOW_ALLOW_FILE_STORE=true

# Model Registry
MODEL_NAME=email-priority-classifier
MODEL_VERSION=1          # set to "Production" or integer version

# Data paths (override defaults if needed)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_FEATURES_DIR=data/features
DATA_REFERENCE_DIR=data/reference

# Serving
# Reference model for serving (ADR-013) and its evaluation run (holds the threshold).
# Build the lookup first: python -m src.serving.build_lookup
# Run: uvicorn src.serving.app:app --port 8000
MODEL_RUN_ID=7189707b198f47748f89965712eee4bc
EVAL_RUN_ID=559ccf6356494eecabb332c47eff2105
SENDER_LOOKUP_PATH=data/reference/sender_frequency.json
API_HOST=0.0.0.0
API_PORT=8000
PREDICTION_LOG_DB=data/predictions.db

# Monitoring
DRIFT_CHECK_EVERY_N_PREDICTIONS=500
DRIFT_ALERT_THRESHOLD=0.20    # fraction of features drifted to trigger alert

# Prometheus
PROMETHEUS_PORT=8001
