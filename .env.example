# Copy this to .env and fill in values. Never commit .env.

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=email-priority-classifier

# Model Registry
MODEL_NAME=email-priority-classifier
MODEL_VERSION=1          # set to "Production" or integer version

# Data paths (override defaults if needed)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_FEATURES_DIR=data/features
DATA_REFERENCE_DIR=data/reference

# Serving
API_HOST=0.0.0.0
API_PORT=8000
PREDICTION_LOG_DB=data/predictions.db

# Monitoring
DRIFT_CHECK_EVERY_N_PREDICTIONS=500
DRIFT_ALERT_THRESHOLD=0.20    # fraction of features drifted to trigger alert

# Prometheus
PROMETHEUS_PORT=8001
